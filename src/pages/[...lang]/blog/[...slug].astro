---
import { type CollectionEntry, render } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';
import { getBlogPosts } from '../../../lib/content/blog';
import { LOCALES, localeParam } from '../../../i18n/config';
import { extractSeoDescription } from '../../../lib/content/text';
import { getRelatedMap } from '../../../lib/content/related';

export async function getStaticPaths() {
	const posts = await getBlogPosts();
	const relatedMap = await getRelatedMap(posts);
	const byId = new Map(posts.map((post) => [post.id, post]));

	return LOCALES.flatMap((value) =>
		posts.map((post) => ({
			params: { lang: localeParam(value), slug: post.id },
			props: {
				post,
				related: (relatedMap.get(post.id) ?? []).flatMap((id) => {
					const item = byId.get(id);
					return item ? [{ slug: item.id, title: item.data.title, pubDate: item.data.pubDate }] : [];
				}),
			},
		})),
	);
}
type Props = {
	post: CollectionEntry<'blog'>;
	related: Array<{ slug: string; title: string; pubDate: Date }>;
};

const { post, related } = Astro.props;
const { Content, headings } = await render(post);
const seoDescription =
	(post.data.description?.trim() || extractSeoDescription(post.body ?? '') || post.data.title).trim();
const body = post.body ?? '';
const hasMath = /\$\$[\s\S]*?\$\$|\\\([\s\S]*?\\\)|\\\[[\s\S]*?\\\]|\$[^$\n]+\$|\\begin\{[a-zA-Z*]+\}/.test(
	body,
);

// 計算字數和閱讀時間
const wordCount = body ? body.replace(/[#*`~>\[\]\(\)\-\!\s]/g, '').length : 0;
const readingTime = Math.ceil(wordCount / 400);
---

<BlogPost
	{...post.data}
	headings={headings}
	slug={post.id}
	wordCount={wordCount}
	readingTime={readingTime}
	seoDescription={seoDescription}
	loadKatexStyles={hasMath}
	related={related}
>
	<Content />
</BlogPost>

