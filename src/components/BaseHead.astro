---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { LOCALES, LOCALE_TAGS, DEFAULT_LOCALE, localePath, stripLocale } from '../i18n/config';
import { ClientRouter } from 'astro:transitions';
import type { ImageMetadata } from 'astro';
import {
	faviconIco,
	heroConfig,
	locale,
	siteTitle,
	siteTitleSuffix,
	siteUrl,
} from '../config';

type SchemaObject = Record<string, unknown>;

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	type?: 'website' | 'article';
	noindex?: boolean;
	publishedTime?: Date | string;
	modifiedTime?: Date | string;
	section?: string;
	tags?: string[];
	schema?: SchemaObject | SchemaObject[];
	canonical?: string | URL;
}

const siteURL = Astro.site ?? new URL(siteUrl);
const ogLocale = locale.replace('-', '_');
const defaultSeoImage = heroConfig.home.backgroundImage;

function normalizeDate(value?: Date | string) {
	if (!value) return undefined;
	const date = value instanceof Date ? value : new Date(value);
	return Number.isNaN(date.valueOf()) ? undefined : date.toISOString();
}

const {
	title,
	description,
	image = defaultSeoImage,
	type = 'website',
	noindex = false,
	publishedTime,
	modifiedTime,
	section,
	tags = [],
	schema,
	canonical,
} = Astro.props;

const canonicalURL = canonical
	? new URL(canonical.toString(), siteURL)
	: new URL(Astro.url.pathname, siteURL);
const pageURL = canonicalURL.toString();
const imageSrc = typeof image === 'string' ? image : image.src;
const imageURL = new URL(imageSrc, siteURL).toString();
const robotsContent = noindex
	? 'noindex,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1'
	: 'index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1';
const publishedTimeISO = normalizeDate(publishedTime);
const modifiedTimeISO = normalizeDate(modifiedTime);
const schemaList = !schema ? [] : Array.isArray(schema) ? schema : [schema];
const localeNeutralPath = stripLocale(Astro.url.pathname);
const alternateLocales = LOCALES.map((value) => ({
	tag: LOCALE_TAGS[value],
	href: new URL(localePath(localeNeutralPath, value), siteURL).toString(),
}));
const defaultLocaleHref = new URL(localePath(localeNeutralPath, DEFAULT_LOCALE), siteURL).toString();
const normalizedTitle = title.trim();
const normalizedTitleSuffix = siteTitleSuffix.trim();
const fullTitle =
	normalizedTitleSuffix && !normalizedTitle.endsWith(normalizedTitleSuffix)
		? `${normalizedTitle} | ${normalizedTitleSuffix}`
		: normalizedTitle;
---

<!-- Global Metadata -->
<meta charset="utf-8" transition:persist />
<meta name="viewport" content="width=device-width,initial-scale=1" transition:persist />
<link rel="icon" href={faviconIco} sizes="any" transition:persist />
<link rel="sitemap" href="/sitemap-index.xml" transition:persist />
<link
	rel="alternate"
	type="application/rss+xml"
	title={siteTitle}
	href={new URL('rss.xml', siteURL)}
	transition:persist
/>
<meta name="generator" content={Astro.generator} transition:persist />
<!-- 字型改成 <link> 而不是 CSS @import：@import 要等主 CSS 下載完才開始抓字型，多一段阻塞。 -->
<link rel="preconnect" href="https://fonts.googleapis.com" transition:persist />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin transition:persist />
<link
	rel="stylesheet"
	href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
	transition:persist
/>
<!-- 全站每一頁的 hero 都是同一張背景圖，在這裡 preload 一次就涵蓋所有頁面。 -->
<link rel="preload" as="image" href={heroConfig.postDefaultBackground} fetchpriority="high" />
<!-- Google Search Console 網站擁有權驗證；移除這行會讓 Search Console 失去驗證。 -->
<meta
	name="google-site-verification"
	content="7pXd-VokkvZffC6qN-S3gxwpdsH-3asxVW1pWgQfgKM"
	transition:persist
/>

<!-- Theme initialization — prevents flash of wrong theme -->
<script is:inline transition:persist>
(function() {
  function getTheme() {
    const stored = localStorage.getItem('theme');
    if (stored) return stored;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }
  // 首次載入立即應用
  document.documentElement.setAttribute('data-theme', getTheme());
  // View Transitions: 在 DOM 交換前將主題寫入新文件，徹底消除閃爍
  document.addEventListener('astro:before-swap', (ev) => {
    ev.newDocument.documentElement.setAttribute('data-theme', getTheme());
  });
})();
</script>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- 語言版本對照：同一篇的三個語言互指，x-default 指向繁體原稿。 -->
{alternateLocales.map(({ tag, href }) => (
	<link rel="alternate" hreflang={tag} href={href} />
))}
<link rel="alternate" hreflang="x-default" href={defaultLocaleHref} />

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="robots" content={robotsContent} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={pageURL} />
<meta property="og:site_name" content={siteTitle} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
{type === 'article' && publishedTimeISO && (
	<meta property="article:published_time" content={publishedTimeISO} />
)}
{type === 'article' && modifiedTimeISO && (
	<meta property="article:modified_time" content={modifiedTimeISO} />
)}
{type === 'article' && section && <meta property="article:section" content={section} />}
{type === 'article' &&
	tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={pageURL} />
<meta property="twitter:title" content={fullTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageURL} />
{schemaList.map((item) => (
	<script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
))}

<!-- View Transitions -->
<ClientRouter />

<style is:global>
  /* ============================================
   * Material Design 3 — Core Easing Curves
   * 
   * 1. Emphasized Decelerate: cubic-bezier(0.05, 0.7, 0.1, 1.0)
   *    → For entering/appearing elements (快速啟動，緩慢著陸)
   *
   * 2. Emphasized Accelerate: cubic-bezier(0.3, 0.0, 0.8, 0.15)
   *    → For exiting/disappearing elements (慢速啟動，快速離場)
   *
   * 3. Emphasized (Standard): cubic-bezier(0.2, 0.0, 0.0, 1.0)
   *    → For shared-axis / morphing transitions (柔和的全程過渡)
   * ============================================ */

  /* 頁面退出動畫 — Emphasized Accelerate: 緩慢拾起，迅速消失 */
  @keyframes md3SlideOut {
    from {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    30% {
      opacity: 1;
      transform: translateY(-2px) scale(1.005);
    }
    to {
      opacity: 0;
      transform: translateY(-30px) scale(0.97);
    }
  }
  
  /* 頁面進入動畫 — Emphasized Decelerate: 迅速到達，優雅著陸 */
  @keyframes md3SlideIn {
    from {
      opacity: 0;
      transform: translateY(40px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* 交叉淡入 — 用於 Hero 等共享元素 */
  @keyframes md3FadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes md3FadeOut {
    from { opacity: 1; }
    to   { opacity: 0; }
  }
  
  /* ---- 主要內容區域過渡 ---- */
  ::view-transition-old(page-content) {
    animation: md3SlideOut 0.25s cubic-bezier(0.3, 0.0, 0.8, 0.15) forwards;
  }
  
  ::view-transition-new(page-content) {
    animation: md3SlideIn 0.4s cubic-bezier(0.05, 0.7, 0.1, 1.0) forwards;
  }

  /* Header 保持不動，不參與過渡動畫 */
  ::view-transition-group(header) {
    animation: none;
    z-index: 100;
  }
  ::view-transition-old(header),
  ::view-transition-new(header) {
    animation: none;
  }

  /* SearchModal 保持不動 */
  ::view-transition-group(search-modal) {
    animation: none;
  }
  ::view-transition-old(search-modal),
  ::view-transition-new(search-modal) {
    animation: none;
  }

  /* ---- Hero 區域過渡 — Emphasized Standard ---- */
  ::view-transition-group(hero) {
    animation-duration: 0.5s;
    animation-timing-function: cubic-bezier(0.2, 0.0, 0.0, 1.0);
    z-index: 1;
    overflow: hidden;
  }

  ::view-transition-old(hero),
  ::view-transition-new(hero) {
    animation: none;
    mix-blend-mode: normal;
    object-fit: none;
    object-position: center; 
    height: 100%;
    width: 100%;
  }

  /* ---- 內容區域組過渡 — Emphasized Standard ---- */
  ::view-transition-group(page-content) {
    animation-duration: 0.5s;
    animation-timing-function: cubic-bezier(0.2, 0.0, 0.0, 1.0);
    z-index: 10;
  }
  
</style>
