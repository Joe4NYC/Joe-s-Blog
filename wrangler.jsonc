{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "joe-s-blog",
	"main": "worker/index.ts",
	"compatibility_date": "2026-07-14",
	// 自訂網域：DNS 記錄由 wrangler 在 joenyc.net 這個 zone 自動建立。
	"routes": [{ "pattern": "blogs.joenyc.net", "custom_domain": true }],
	// 只留自訂網域；workers.dev 網址刻意關閉，避免同一份內容有兩個入口。
	"workers_dev": false,
	// 文章瀏覽計數。
	"kv_namespaces": [{ "binding": "VIEWS", "id": "39624a71b3b94b59bb108d57e724f6b5" }],
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash",
		// 只有後台 API 走 Worker，其餘網址一律直接由靜態資源服務，前台效能不受影響。
		"run_worker_first": ["/api/*"]
	},
	"vars": {
		"ADMIN_USERNAME": "joe",
		"GITHUB_OWNER": "Joe4NYC",
		"GITHUB_REPO": "Joe-s-Blog",
		"GITHUB_BRANCH": "main",
		"DEPLOY_WORKFLOW": "deploy.yml",
		"SESSION_TTL_HOURS": "12"
	}
	// 機密值請用 npx wrangler secret put 設定，不要寫在這個檔案：
	//   ADMIN_PASSWORD / SESSION_SECRET / GITHUB_TOKEN
}
